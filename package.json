{
  "name": "our-stage",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first AI-assisted MMD character director playground.",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n editor,desktop -c auto \"pnpm dev:editor\" \"pnpm dev:desktop\"",
    "dev:editor": "vite --config apps/editor/vite.config.ts",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "pnpm build:editor && pnpm build:desktop",
    "build:editor": "vite build --config apps/editor/vite.config.ts",
    "build:desktop": "node scripts/build-desktop.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "start": "electron apps/desktop/dist/main.cjs",
    "package:windows": "pnpm build && electron-forge make --config apps/desktop/forge.config.cjs --platform win32 --arch x64"
  },
  "dependencies": {
    "immer": "11.1.15",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@eslint/js": "10.7.0",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.0.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "electron": "43.2.0",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.42.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
